# Template only — never put real values in this file (git tracks it).
# Copy it to .env.local (gitignored) and fill that in, then add the same
# values in Vercel → Settings → Environment Variables for the live site.
#
# Powers every form: contact (app/api/contact), tarot intake (app/api/reading),
# live booking (app/api/booking) and the app waitlist (app/api/waitlist, which
# saves signups to Resend Contacts — so the key needs full access).
RESEND_API_KEY=

# The inbox where messages, reading requests, bookings and signups arrive.
# With the sandbox sender below, this must be the Resend account's own email.
CONTACT_TO_EMAIL=

# Must be onboarding@resend.dev until a domain is verified in Resend;
# after verifying, use something like "Screen Sage <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Screen Sage <onboarding@resend.dev>
